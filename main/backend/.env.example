# MongoDB has no authentication by default — unlike Firebase, it will not
# lock itself down for you. Before this ever runs anywhere but a throwaway
# local machine: enable --auth on the mongod server, create a user scoped to
# this database, and put its credentials in the URL below. A credential-less
# URL (like the placeholder below) is refused outright in production — see
# config/db.js.
#   mongodb://<user>:<pass>@<host>:27017/?authSource=admin
MONGODB_URL=mongodb://127.0.0.1:27017
# Optional — defaults to "fute_portal" if unset
MONGODB_DB_NAME=fute_portal
JWT_SECRET=your_jwt_secret_key

# Self-hosted mail capture (maildev) — no auth required. Point at a real
# relay (with SMTP_USER/SMTP_PASS) instead if real delivery is ever needed.
SMTP_HOST=localhost
SMTP_PORT=1025

HR_EMAIL=hr.fute2@gmail.com
IT_EMAIL=system.futeservice@gmail.com

# Founder dashboard's "AI Cabinet" feature (controllers/aiCabinetController.js).
# Used server-side only — the frontend never sees this key. Leave unset to
# have the feature respond with a clear "not configured" error instead of
# silently working; there is no client-supplied fallback anymore.
GEMINI_API_KEY=

PORT=5000
