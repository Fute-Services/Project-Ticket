# Copy to .env.test (gitignored — never commit real credentials here) and
# fill in real test-account credentials for whichever roles you need to run
# e2e specs against. A role left unset has its specs skipped, not run
# against a placeholder password — see tests/e2e/helpers.js.
E2E_FOUNDER_EMAIL=
E2E_FOUNDER_PASSWORD=

E2E_HR_EMAIL=
E2E_HR_PASSWORD=

E2E_IT_EMAIL=
E2E_IT_PASSWORD=

E2E_COORDINATOR_EMAIL=
E2E_COORDINATOR_PASSWORD=

E2E_EMPLOYEE_EMAIL=
E2E_EMPLOYEE_PASSWORD=

E2E_PRODUCTION_EMAIL=
E2E_PRODUCTION_PASSWORD=
